<?xml version="1.0" encoding="utf-8"?>
<!-- EasyTier adaptive-icon foreground: the same mesh-of-nodes mark as the
     notification icon, refined (ring hub, round-cap links). All artwork stays
     inside a ~62dp circle centred on the 108dp viewport, i.e. within both the
     72dp safe zone and stricter 66dp circular launcher masks. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- links: hub (54,54) to three satellites, plus a peer link across the top -->
    <path
        android:strokeColor="#1EC8A3"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M36,38 L72,38" />
    <path
        android:strokeColor="#1EC8A3"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M36,38 L54,54" />
    <path
        android:strokeColor="#1EC8A3"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M72,38 L54,54" />
    <path
        android:strokeColor="#1EC8A3"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M54,54 L54,78" />

    <!-- hub node as a ring (even-odd donut) -->
    <path
        android:fillColor="#1EC8A3"
        android:fillType="evenOdd"
        android:pathData="M44,54 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0 Z M50,54 a4,4 0 1,1 8,0 a4,4 0 1,1 -8,0 Z" />

    <!-- satellite nodes -->
    <path
        android:fillColor="#1EC8A3"
        android:pathData="M29,38 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0 Z" />
    <path
        android:fillColor="#1EC8A3"
        android:pathData="M65,38 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0 Z" />
    <path
        android:fillColor="#1EC8A3"
        android:pathData="M47,78 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0 Z" />
</vector>
